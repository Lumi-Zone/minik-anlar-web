---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import { SITE, APP_STORE, withBase } from '../config';

const title = 'Destek ve SSS – Minik Anlar';
const description =
  'Minik Anlar destek sayfası: sık sorulan sorular, sorun giderme adımları ve iletişim e-postası.';

/** Landing SSS'sinden farklı: burada sorun giderme ağırlıklı sorular yer alır. */
const supportFaq = [
  {
    q: 'Gebelik haftam yanlış görünüyor, nasıl düzeltirim?',
    a: 'Ayarlar bölümünden gebelik bilgilerini düzenleyebilirsin. Hafta hesabı 280 günlük gebelik üzerinden yapılır; son adet tarihi girdiysen hesap doğrudan bu tarihten, gebe kalma tarihi girdiysen 14 gün öncesinden, tahmini doğum tarihi girdiysen 280 gün öncesinden başlar. Doktorunun verdiği hafta ile küçük farklar olması normaldir.',
  },
  {
    q: 'Hatırlatıcı bildirimleri gelmiyor.',
    a: 'Önce iPhone Ayarlar → Bildirimler → Minik Anlar yolundan bildirim izninin açık olduğunu kontrol et. Odaklanma (Focus) veya Rahatsız Etmeyin modu açıksa bildirimler ertelenebilir. İzin verdikten sonra uygulamadaki Ayarlar bölümünden hatırlatıcı saatlerini yeniden kaydetmen gerekebilir.',
  },
  {
    q: 'Premium satın aldım ama özellikler açılmadı.',
    a: 'Satın alma ekranındaki "Satın alımları geri yükle" seçeneğini dene; bu işlem internet bağlantısı gerektirir ve satın almanın yapıldığı Apple Kimliği ile giriş yapmış olman gerekir. Ödeme "beklemede" durumundaysa (örneğin aile onayı gerekiyorsa) Apple onayı tamamlayana kadar erişim açılmaz. Sorun sürerse aşağıdaki adresten bize yaz.',
  },
  {
    q: 'Yeni telefona geçiyorum, verilerim taşınır mı?',
    a: 'Veriler cihazında saklandığı için otomatik olarak taşınmaz. iCloud veya bilgisayar üzerinden alınan tam cihaz yedeğini yeni telefona geri yüklersen uygulama verilerin de gelir. Ayrıca uygulamadaki Ayarlar bölümünden tüm kayıtlarını ve fotoğraflarını tek arşiv dosyası olarak dışa aktarabilirsin. Premium aboneliğin aynı Apple Kimliğiyle geri yüklenir.',
  },
  {
    q: 'Fotoğraflarım ve anılarım nerede saklanıyor?',
    a: 'Uygulamanın kendi izole klasöründe, telefonunda. Bir sunucuya yüklenmez ve bizim bu dosyalara erişimimiz yoktur. Uygulamayı silersen bu dosyalar da kalıcı olarak silinir.',
  },
  {
    q: 'Uygulamayı sildim, verilerimi geri alabilir miyim?',
    a: 'Ne yazık ki hayır. Uygulamanın sunucusu ve hesabı olmadığı için bizde bir kopya bulunmaz. Yalnızca daha önce aldığın bir cihaz yedeği veya dışa aktardığın arşiv dosyası varsa geri dönebilirsin.',
  },
  {
    q: 'Aboneliğimi nasıl iptal ederim?',
    a: `iPhone Ayarlar → [adın] → Abonelikler → Minik Anlar → Aboneliği İptal Et. Ayrıntılar için <a href="${withBase('/abonelik-kosullari/')}">Abonelik Koşulları</a> sayfasına bakabilirsin.`,
  },
  {
    q: 'Android sürümü var mı?',
    a: `Şu an yalnızca iPhone için sunuluyor (iOS ${APP_STORE.minimumOSVersion} ve üzeri).`,
  },
  {
    q: 'Uygulama tıbbi tavsiye veriyor mu?',
    a: 'Hayır. İçerikler bilgilendirme ve kişisel takip amaçlıdır, tıbbi tavsiye yerine geçmez. Sağlık kararların için doktoruna danış.',
  },
];
---

<BaseLayout title={title} description={description}>
  <main id="main">
    <div class="container prose-wrap">
      <header class="page-header">
        <h1 class="page-title">Destek</h1>
        <p class="lede">
          Bir sorun mu yaşıyorsun, bir önerin mi var? Aşağıdaki sorular çoğu durumu
          çözüyor; çözmezse bize doğrudan yazabilirsin.
        </p>
      </header>

      <div class="contact card">
        <h2>Bize ulaş</h2>
        <p>Her türlü soru, hata bildirimi ve öneri için:</p>
        <a href={`mailto:${SITE.supportEmail}`} class="email">{SITE.supportEmail}</a>
        <p class="hint">
          Hata bildiriyorsan iPhone modelini, iOS sürümünü ve sorunun hangi ekranda
          olduğunu yazarsan çok daha hızlı yardımcı olabiliriz. E-postalara genellikle
          birkaç iş günü içinde yanıt veriyoruz.
        </p>
      </div>
    </div>

    <FAQ items={supportFaq} title="Sık sorulan sorular" id="destek-sss" />
  </main>
</BaseLayout>

<style>
  .lede {
    max-width: 52ch;
    margin-top: var(--space-3);
    color: var(--ink-2);
    font-size: var(--text-lg);
  }

  .contact {
    padding: clamp(24px, 5vw, 36px);
  }

  .contact h2 {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
  }

  .contact p {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .email {
    display: inline-block;
    margin: var(--space-3) 0 var(--space-5);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .hint {
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
</style>
