---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

const title = "Sayfa Bulunamadı – Minik Anlar";
const description = "Aradığınız sayfa bulunamadı.";
---

<BaseLayout title={title} description={description}>
  <main class="error-page">
    <div class="container text-center">
      <h1>404</h1>
      <h2>Sayfa Bulunamadı</h2>
      <p>Aradığınız sayfa taşınmış veya silinmiş olabilir.</p>
      <a href="/" class="btn">Ana Sayfaya Dön</a>
    </div>
  </main>
  
  <Footer />
</BaseLayout>

<style>
  .error-page {
    padding: 120px 0;
    min-height: 60vh;
    display: flex;
    align-items: center;
    background-color: var(--pageBackground);
  }
  
  .text-center {
    text-align: center;
  }
  
  h1 {
    font-size: 6rem;
    color: var(--accent);
    margin-bottom: 10px;
    line-height: 1;
  }
  
  h2 {
    font-size: 2rem;
    color: var(--ink);
    margin-bottom: 20px;
  }
  
  p {
    font-size: 1.2rem;
    color: var(--text-secondary);
    margin-bottom: 40px;
  }
</style>
