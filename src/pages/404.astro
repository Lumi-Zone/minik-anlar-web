---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

const title = 'Sayfa bulunamadı – Minik Anlar';
const description = 'Aradığın sayfa bulunamadı.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <main id="main" class="notfound">
    <div class="container">
      <p class="code">404</p>
      <h1>Bu sayfayı bulamadık</h1>
      <p class="text">
        Aradığın sayfa taşınmış veya adresi değişmiş olabilir.
      </p>

      <a href="/" class="btn">Ana sayfaya dön</a>

      <nav class="links" aria-label="Diğer sayfalar">
        <a href="/support/">Destek</a>
        <a href="/gizlilik-politikasi/">Gizlilik Politikası</a>
        <a href="/kullanim-kosullari/">Kullanım Koşulları</a>
        <a href="/abonelik-kosullari/">Abonelik Koşulları</a>
      </nav>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .notfound {
    padding: 100px 0 120px;
    text-align: center;
  }

  .code {
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--primary-muted);
    line-height: 1;
    margin-bottom: 12px;
  }

  .notfound h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin-bottom: 12px;
  }

  .text {
    color: var(--text-secondary);
    margin-bottom: 32px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 24px;
    margin-top: 44px;
    font-size: 0.9375rem;
  }

  .links a {
    color: var(--text-secondary);
  }
</style>
