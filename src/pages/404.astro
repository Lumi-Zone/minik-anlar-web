---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Sayfa bulunamadı – Minik Anlar';
const description = 'Aradığın sayfa bulunamadı.';

const links = [
  { href: '/support/', label: 'Destek' },
  { href: '/gizlilik-politikasi/', label: 'Gizlilik Politikası' },
  { href: '/kullanim-kosullari/', label: 'Kullanım Koşulları' },
  { href: '/abonelik-kosullari/', label: 'Abonelik Koşulları' },
];
---

<BaseLayout title={title} description={description} noindex={true}>
  <main id="main" class="notfound">
    <div class="container">
      <p class="code">404</p>
      <h1>Bu sayfayı bulamadık</h1>
      <p class="text">Aradığın sayfa taşınmış veya adresi değişmiş olabilir.</p>

      <a href="/" class="btn">Ana sayfaya dön</a>

      <nav class="links" aria-label="Diğer sayfalar">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
  </main>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(72px, 12vw, 128px);
    text-align: center;
  }

  .code {
    margin-bottom: var(--space-3);
    color: var(--brand-deep);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  h1 {
    font-size: var(--display-md);
  }

  .text {
    max-width: 44ch;
    margin: var(--space-4) auto var(--space-7);
    color: var(--ink-2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-8);
    font-size: var(--text-sm);
  }

  .links a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
