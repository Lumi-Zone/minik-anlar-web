---
/**
 * Premium tanıtımı. Fiyat gösterilmez: güncel tutar bölgeye ve Apple'ın
 * fiyatlandırmasına göre değiştiği için tek doğru yer satın alma ekranıdır.
 */
import { SUBSCRIPTIONS, PREMIUM_BENEFITS } from '../config';

const planNames = SUBSCRIPTIONS.map((plan) => plan.name).join(' ve ');
---

<section class="premium" id="premium" aria-labelledby="premium-title">
  <div class="container">
    <div class="section-heading center">
      <span class="eyebrow">İsteğe bağlı</span>
      <h2 id="premium-title">Minik Anlar Premium</h2>
      <p>
        Hafta hafta takip, günlük ve anı defteri her zaman ücretsiz. Premium,
        biriktirdiğin anıları saklanacak bir hikâyeye dönüştürür.
      </p>
    </div>

    <ul class="benefits list-reset">
      {
        PREMIUM_BENEFITS.map((benefit) => (
          <li>
            <h3>{benefit.title}</h3>
            <p>{benefit.detail}</p>
          </li>
        ))
      }
    </ul>

    <div class="terms">
      <p>
        <strong>{planNames}</strong> olmak üzere iki abonelik sunulur; her ikisi de
        otomatik yenilenir. Güncel fiyat ve sana tanımlıysa ücretsiz deneme süresi,
        satın almayı onaylamadan önce uygulama içindeki satın alma ekranında
        gösterilir. Dönem bitiminden en az 24 saat önce iptal etmezsen abonelik
        yenilenir ve ücret Apple Kimliğinden tahsil edilir.
      </p>

      <p class="links">
        <a href="/abonelik-kosullari/">Abonelik Koşulları</a>
        <a href="/kullanim-kosullari/">Kullanım Koşulları</a>
        <a href="/gizlilik-politikasi/">Gizlilik Politikası</a>
      </p>
    </div>
  </div>
</section>

<style>
  .premium {
    padding-block: var(--section-y);
    background: var(--surface);
    border-block: 1px solid var(--line);
  }

  .benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .benefits li {
    padding: var(--space-6);
    border-radius: var(--radius);
    background: var(--page);
  }

  .benefits h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
  }

  .benefits p {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .terms {
    max-width: 68ch;
    margin: var(--space-8) auto 0;
    text-align: center;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .terms strong {
    color: var(--ink);
    font-weight: 600;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
  }

  .links a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .benefits {
      grid-template-columns: 1fr;
    }
  }
</style>
