---
import { SITE, APP_STORE, appStoreUrl, downloadLabel } from '../config';

const facts = ['40 hafta içerik', 'Hesap gerekmez', 'Reklamsız'];
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="badge">iPhone için · Tamamen Türkçe</p>

      <h1>Hamilelik takibi ve anı defteri, tek uygulamada</h1>

      <p class="subtitle">
        Hafta hafta gebelik yolculuğunu takip et, en özel anlarını sakla.
        Hesap açmadan, reklamsız — kayıtların telefonunda kalır.
      </p>

      <div class="cta-group">
        {
          appStoreUrl ? (
            <a href={appStoreUrl} class="btn">
              {downloadLabel}
            </a>
          ) : (
            <span class="btn is-pending">{downloadLabel}</span>
          )
        }
        <a href="#ozellikler" class="btn btn-secondary">Özellikleri gör</a>
      </div>

      <ul class="facts list-reset">
        {facts.map((fact) => <li>{fact}</li>)}
      </ul>

      <p class="platform-note">iOS {APP_STORE.minimumOSVersion} ve üzeri</p>
    </div>

    <div class="hero-visual">
      <!-- Uygulamanın Bugün ekranının stilize gösterimi. Yayında gerçek
           ekran görüntüsüyle değiştirilecek (bkz. plan.md Faz 2). -->
      <div
        class="phone"
        role="img"
        aria-label={`${SITE.name} uygulamasının Bugün ekranı: gebelik ilerleme halkası, bebek boyutu kartı ve haftalık özet`}
      >
        <div class="screen">
          <span class="notch" aria-hidden="true"></span>

          <div class="ring-wrap">
            <svg viewBox="0 0 120 120" class="ring" aria-hidden="true">
              <circle cx="60" cy="60" r="52" fill="none" stroke="#EAE4DC" stroke-width="8" />
              <circle
                cx="60"
                cy="60"
                r="52"
                fill="none"
                stroke="var(--brand)"
                stroke-width="8"
                stroke-linecap="round"
                stroke-dasharray="327"
                stroke-dashoffset="98"
                transform="rotate(-90 60 60)"
              />
            </svg>
            <p class="ring-center">
              <strong>24</strong>
              <span>hafta 3 gün</span>
            </p>
          </div>

          <p class="trimester">2. trimester</p>

          <div class="tile size-tile">
            <span class="tile-icon" aria-hidden="true">🌽</span>
            <span class="tile-text">
              <span class="tile-label">Bu hafta bebeğin</span>
              <span class="tile-title">Bir mısır koçanı kadar</span>
              <span class="tile-meta">≈ 30 cm · 600 g</span>
            </span>
          </div>

          <div class="tile">
            <span class="tile-label">
              Haftalık özet
              <span class="pill">Yeni</span>
            </span>
            <span class="tile-title">İç kulak dengeyi öğreniyor</span>
            <span class="bar"></span>
            <span class="bar short"></span>
          </div>

          <div class="tabbar" aria-hidden="true">
            <span class="tab active">Bugün</span>
            <span class="tab">Günlük</span>
            <span class="tab">Anılar</span>
            <span class="tab">Ayarlar</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(48px, 7vw, 88px) clamp(56px, 7vw, 96px);
    overflow: hidden;
  }

  /* Telefonun arkasındaki yumuşak ışık — derinlik verir, dikkat dağıtmaz. */
  .hero::before {
    content: '';
    position: absolute;
    inset-block-start: -18%;
    inset-inline-end: -8%;
    width: min(760px, 90vw);
    aspect-ratio: 1;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--brand) 20%, transparent) 0%,
      transparent 68%
    );
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
  }

  .badge {
    display: inline-block;
    margin-bottom: var(--space-5);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  h1 {
    font-size: var(--display-lg);
    letter-spacing: -0.03em;
  }

  .subtitle {
    max-width: 42ch;
    margin-top: var(--space-5);
    color: var(--ink-2);
    font-size: var(--text-lg);
  }

  .cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-6);
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .facts li::before {
    content: '✓';
    margin-right: var(--space-2);
    color: var(--brand-deep);
    font-weight: 700;
  }

  .platform-note {
    margin-top: var(--space-4);
    color: var(--ink-3);
    font-size: var(--text-xs);
  }

  /* --- Telefon --- */

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .phone {
    width: 300px;
    padding: 10px;
    border-radius: 44px;
    background: var(--surface);
    box-shadow: var(--shadow-md), 0 0 0 1px var(--line);
  }

  .screen {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 16px 14px 10px;
    border-radius: 35px;
    background: var(--page);
  }

  .notch {
    width: 68px;
    height: 5px;
    margin-inline: auto;
    border-radius: var(--radius-pill);
    background: var(--line-strong);
  }

  .ring-wrap {
    position: relative;
    width: 136px;
    margin: var(--space-2) auto 0;
  }

  .ring {
    width: 136px;
    height: 136px;
  }

  .ring-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1.2;
  }

  .ring-center strong {
    font-size: 2.375rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .ring-center span {
    color: var(--ink-2);
    font-size: var(--text-xs);
  }

  .trimester {
    color: var(--brand-deep);
    font-size: var(--text-xs);
    font-weight: 600;
    text-align: center;
  }

  .tile {
    display: flex;
    flex-direction: column;
    padding: 13px;
    border-radius: 15px;
    background: var(--surface);
    box-shadow: var(--shadow-xs);
    text-align: left;
  }

  .size-tile {
    flex-direction: row;
    align-items: center;
    gap: var(--space-3);
  }

  .tile-text {
    display: flex;
    flex-direction: column;
  }

  .tile-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 13px;
    background: var(--butter);
    font-size: 1.35rem;
  }

  .tile-label {
    color: var(--ink-3);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .tile-title {
    margin-top: 3px;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
  }

  .tile-meta {
    margin-top: 2px;
    color: var(--ink-2);
    font-size: 0.75rem;
  }

  .pill {
    display: inline-block;
    margin-left: var(--space-1);
    padding: 1px 7px;
    border-radius: var(--radius-pill);
    background: var(--brand-soft);
    color: var(--brand-deep);
    font-size: 0.625rem;
    letter-spacing: 0;
  }

  .bar {
    height: 6px;
    margin-top: var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--surface-sunken);
  }

  .bar.short {
    width: 60%;
  }

  .tabbar {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-2);
    padding: 10px 4px 2px;
    border-top: 1px solid var(--line);
  }

  .tab {
    color: var(--ink-3);
    font-size: 0.6875rem;
  }

  .tab.active {
    color: var(--brand-deep);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .hero-copy {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* Satır kaydırıldığında ikinci satır da ortada kalsın. */
    .cta-group,
    .facts {
      justify-content: center;
    }

    /* Görsel metnin ardında kalır: dar ekranda ilk ekranı başlık ve
       birincil eylem doldurmalı, stilize telefon değil. */
    .hero-visual {
      order: 1;
    }
  }
</style>
