---
import { SITE, appStoreUrl, downloadLabel } from '../config';
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">iPhone için · Türkçe</p>
      <h1>{SITE.name} — Hamilelik Takibi ve Anı Defteri</h1>
      <p class="subtitle">
        Hafta hafta gebelik yolculuğunu takip et, en özel anlarını tek yerde sakla.
        Hesap açmadan, reklamsız.
      </p>

      <div class="cta-group">
        {
          appStoreUrl ? (
            <a href={appStoreUrl} class="btn btn-appstore">
              {downloadLabel}
            </a>
          ) : (
            <span class="btn btn-appstore is-pending">{downloadLabel}</span>
          )
        }
        <a href="#ozellikler" class="btn btn-ghost">Özellikleri gör</a>
      </div>

      <ul class="hero-facts">
        <li>40 hafta içerik</li>
        <li>Hesap gerekmez</li>
        <li>Reklamsız</li>
      </ul>
    </div>

    <div class="hero-visual">
      <!-- Uygulamanın Bugün ekranının stilize gösterimi. Yayında gerçek
           ekran görüntüsüyle değiştirilecek (bkz. plan.md Faz 2). -->
      <div class="phone" role="img" aria-label="Minik Anlar uygulamasının Bugün ekranı: gebelik ilerleme halkası, haftalık özet ve bebek boyutu kartı">
        <div class="phone-screen">
          <div class="phone-status"><span></span></div>

          <div class="ring-wrap">
            <svg viewBox="0 0 120 120" class="ring" aria-hidden="true">
              <circle cx="60" cy="60" r="52" fill="none" stroke="#EDE8E1" stroke-width="10" />
              <circle
                cx="60"
                cy="60"
                r="52"
                fill="none"
                stroke="#729E84"
                stroke-width="10"
                stroke-linecap="round"
                stroke-dasharray="327"
                stroke-dashoffset="98"
                transform="rotate(-90 60 60)"
              />
            </svg>
            <div class="ring-center">
              <strong>24</strong>
              <span>hafta 3 gün</span>
            </div>
          </div>

          <p class="trimester">2. trimester</p>

          <div class="card size-card">
            <div class="size-icon" aria-hidden="true">🌽</div>
            <div>
              <p class="card-label">Bu hafta bebeğin</p>
              <p class="card-title">Bir mısır koçanı kadar</p>
              <p class="card-meta">≈ 30 cm · 600 g</p>
            </div>
          </div>

          <div class="card summary-card">
            <p class="card-label">Haftalık özet <span class="pill">Yeni</span></p>
            <p class="card-title">İç kulak dengeyi öğreniyor</p>
            <span class="line"></span>
            <span class="line short"></span>
          </div>

          <div class="tabbar" aria-hidden="true">
            <span class="tab active">Bugün</span>
            <span class="tab">Günlük</span>
            <span class="tab">Anılar</span>
            <span class="tab">Ayarlar</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 72px 0 88px;
    background: linear-gradient(180deg, var(--page-bg) 0%, #fff 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    align-items: center;
    gap: 64px;
  }

  .hero-copy h1 {
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    margin-bottom: 20px;
  }

  .subtitle {
    font-size: 1.1875rem;
    color: var(--text-secondary);
    max-width: 34ch;
    margin-bottom: 34px;
  }

  .cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 30px;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    list-style: none;
    padding: 0;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .hero-facts li::before {
    content: '✓';
    color: var(--primary);
    font-weight: 700;
    margin-right: 8px;
  }

  /* --- Telefon --- */

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .phone {
    width: 320px;
    padding: 12px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 46px;
    box-shadow: var(--shadow-soft);
  }

  .phone-screen {
    background: var(--page-bg);
    border-radius: 36px;
    padding: 18px 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .phone-status {
    display: flex;
    justify-content: center;
  }

  .phone-status span {
    width: 74px;
    height: 5px;
    border-radius: 99px;
    background: #ded8d0;
  }

  .ring-wrap {
    position: relative;
    width: 148px;
    margin: 6px auto 0;
  }

  .ring {
    width: 148px;
    height: 148px;
    display: block;
  }

  .ring-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .ring-center strong {
    font-size: 2.5rem;
    line-height: 1;
    color: var(--ink);
  }

  .ring-center span {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .trimester {
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--primary-hover);
    margin-top: -4px;
  }

  .card {
    background: #fff;
    border-radius: 16px;
    padding: 14px;
    box-shadow: var(--shadow-card);
  }

  .size-card {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .size-icon {
    width: 44px;
    height: 44px;
    flex: none;
    display: grid;
    place-items: center;
    font-size: 1.4rem;
    background: var(--butter);
    border-radius: 13px;
  }

  .card-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    font-weight: 700;
    margin-bottom: 3px;
  }

  .card-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.3;
  }

  .card-meta {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-top: 2px;
  }

  .pill {
    display: inline-block;
    background: var(--mint);
    color: var(--primary-hover);
    border-radius: 99px;
    padding: 1px 7px;
    font-size: 0.625rem;
    letter-spacing: 0;
    margin-left: 6px;
  }

  .line {
    display: block;
    height: 7px;
    border-radius: 99px;
    background: #EFEBE5;
    margin-top: 8px;
  }

  .line.short {
    width: 62%;
  }

  .tabbar {
    display: flex;
    justify-content: space-between;
    gap: 4px;
    margin-top: auto;
    padding: 10px 4px 2px;
    border-top: 1px solid var(--line);
  }

  .tab {
    font-size: 0.6875rem;
    color: var(--text-tertiary);
  }

  .tab.active {
    color: var(--primary-hover);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 48px;
      text-align: center;
    }

    .subtitle {
      margin-inline: auto;
    }

    .cta-group,
    .hero-facts {
      justify-content: center;
    }
  }
</style>
