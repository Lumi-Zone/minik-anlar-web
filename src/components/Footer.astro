---
import { SITE } from '../config';

const year = new Date().getFullYear();

const groups = [
  {
    title: 'Ürün',
    links: [
      { href: '/#ozellikler', label: 'Özellikler' },
      { href: '/#premium', label: 'Premium' },
      { href: '/#sss', label: 'Sıkça sorulan sorular' },
    ],
  },
  {
    title: 'Yasal',
    links: [
      { href: '/gizlilik-politikasi/', label: 'Gizlilik Politikası' },
      { href: '/kullanim-kosullari/', label: 'Kullanım Koşulları' },
      { href: '/abonelik-kosullari/', label: 'Abonelik Koşulları' },
    ],
  },
  {
    title: 'Destek',
    links: [
      { href: '/support/', label: 'Destek ve SSS' },
      { href: `mailto:${SITE.supportEmail}`, label: SITE.supportEmail },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="brand">
        <p class="brand-name">{SITE.name}</p>
        <p class="brand-text">
          Hafta hafta gebelik takibi ve anı defteri. iPhone için, tamamen Türkçe.
        </p>
      </div>

      <nav class="groups" aria-label="Alt bilgi bağlantıları">
        {
          groups.map((group) => (
            <div>
              <h2>{group.title}</h2>
              <ul class="list-reset">
                {group.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="bottom">
      <p class="disclaimer">
        <strong>Önemli not:</strong> Minik Anlar uygulaması ve bu web sitesi yalnızca
        bilgilendirme ve kişisel takip amaçlıdır; tıbbi tavsiye, teşhis veya tedavi
        niteliği taşımaz. Sağlığınla ilgili her konuda doktoruna danış.
      </p>
      <p class="copyright">&copy; {year} {SITE.publisher}. Tüm hakları saklıdır.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-9) var(--space-6);
    background: var(--surface);
    border-top: 1px solid var(--line);
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: var(--space-8);
    padding-bottom: var(--space-8);
  }

  .brand-name {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand-text {
    max-width: 34ch;
    margin-top: var(--space-2);
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .groups h2 {
    margin-bottom: var(--space-4);
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .groups ul {
    display: grid;
    gap: var(--space-3);
  }

  .groups a {
    color: var(--ink-2);
    font-size: var(--text-sm);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .groups a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .bottom {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .disclaimer {
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--page);
    color: var(--ink-2);
    font-size: var(--text-xs);
    line-height: 1.7;
  }

  .disclaimer strong {
    color: var(--ink);
  }

  .copyright {
    color: var(--ink-3);
    font-size: var(--text-xs);
    text-align: center;
  }

  @media (max-width: 860px) {
    .top {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }

  @media (max-width: 560px) {
    .groups {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
