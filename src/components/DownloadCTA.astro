<section class="download-cta">
  <div class="container text-center">
    <h2>Hemen Başlayın</h2>
    <p>Hamilelik serüveninizi kaydetmeye başlamak için Minik Anlar'ı ücretsiz indirin.</p>
    <a href="#" class="btn btn-appstore">Yakında App Store'da</a>
  </div>
</section>

<style>
  .download-cta {
    padding: 100px 0;
    background-color: var(--accent);
    color: #fff;
    text-align: center;
  }
  
  .download-cta h2 {
    font-size: 2.5rem;
    margin-bottom: 20px;
    color: #fff;
  }
  
  .download-cta p {
    font-size: 1.2rem;
    margin-bottom: 40px;
    opacity: 0.9;
  }
  
  .btn-appstore {
    background-color: var(--ink);
    color: #fff;
    font-size: 1.1rem;
    padding: 16px 32px;
    border-radius: 30px;
  }
  
  .btn-appstore:hover {
    background-color: #000;
  }
</style>
