---
import { APP_STORE, appStoreUrl, downloadLabel } from '../config';
---

<section class="cta on-dark" aria-labelledby="cta-title">
  <div class="container">
    <h2 id="cta-title">Yolculuğunu bugün kaydetmeye başla</h2>
    <p class="lede">
      Minik Anlar'ı ücretsiz indir; hafta hafta takip, günlük ve anı defteri
      hiçbir ücret ödemeden kullanılabilir.
    </p>

    {
      appStoreUrl ? (
        <a href={appStoreUrl} class="btn">
          {downloadLabel}
        </a>
      ) : (
        <span class="btn is-pending">{downloadLabel}</span>
      )
    }

    <p class="requirement">iPhone · iOS {APP_STORE.minimumOSVersion} ve üzeri · Türkçe</p>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--section-y);
    background: var(--brand-deep);
    color: var(--on-dark);
    text-align: center;
  }

  h2 {
    font-size: var(--display-md);
    color: var(--on-dark);
  }

  .lede {
    max-width: 50ch;
    margin: var(--space-4) auto var(--space-7);
    color: var(--on-dark-2);
    font-size: var(--text-lg);
  }

  .requirement {
    margin-top: var(--space-5);
    color: var(--on-dark-2);
    font-size: var(--text-xs);
  }
</style>
