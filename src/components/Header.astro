---
/**
 * Sabit üst başlık. JavaScript kullanmaz: yapışkanlık, bulanık zemin ve
 * duyarlı davranış tamamen CSS ile çözülür.
 */
import { SITE, NAV, appStoreUrl, downloadLabel, withBase } from '../config';
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={withBase('/')}>
      {/* Uygulamanın marka işareti (Assets.xcassets/BrandMark). Adı yanındaki
          yazı taşıdığı için görsel dekoratiftir: alt boş bırakılır. */}
      <img class="mark" src={withBase('/brand-mark.png')} width="32" height="32" alt="" />
      <span class="wordmark">{SITE.name}</span>
    </a>

    <nav class="nav" aria-label="Ana gezinme">
      {NAV.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
    </nav>

    {
      appStoreUrl ? (
        <a href={appStoreUrl} class="btn btn-sm header-cta">
          {downloadLabel}
        </a>
      ) : (
        <span class="btn btn-sm is-pending header-cta">{downloadLabel}</span>
      )
    }
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--page) 82%, transparent);
    border-bottom: 1px solid var(--line);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-right: auto;
    color: var(--ink);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  /* Uygulama ikonuyla aynı okunsun diye iOS'un yuvarlatılmış kare oranı. */
  .mark {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    box-shadow: 0 0 0 1px var(--line);
  }

  .wordmark {
    font-size: var(--text-base);
  }

  .nav {
    display: flex;
    gap: var(--space-5);
  }

  .nav a {
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--ink);
  }

  @media (max-width: 840px) {
    /* Tek sayfalık akışta bağlantılar zaten sırayla geçiliyor; dar ekranda
       başlık yalnızca marka ve birincil eyleme indirgenir. */
    .nav {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .header-cta {
      display: none;
    }
  }
</style>
