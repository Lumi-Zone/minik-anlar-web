---
/**
 * Gizlilik vaadi. Emoji yerine ince çizgili ikonlar kullanılır; ikonlar
 * dekoratiftir, anlamı her zaman yanındaki metin taşır.
 */
const points = [
  {
    title: 'Cihazda saklanır',
    detail: 'Profil, günlük, fotoğraf ve notlar telefonundan çıkmaz.',
    path: 'M7 10V7.5a5 5 0 0 1 10 0V10M5.5 10h13v10h-13z',
  },
  {
    title: 'Reklam ve IDFA yok',
    detail: 'Reklam ağı, izleme kimliği veya üçüncü taraf analiz yok.',
    path: 'M5.6 5.6l12.8 12.8M12 3a9 9 0 1 1 0 18 9 9 0 0 1 0-18z',
  },
  {
    title: 'Dışa aktarabilirsin',
    detail: 'Tüm kayıtlarını tek arşiv dosyası olarak indirebilirsin.',
    path: 'M12 15V4m0 0L8.5 7.5M12 4l3.5 3.5M4.5 16v4h15v-4',
  },
];
---

<section class="privacy" aria-labelledby="privacy-title">
  <div class="container">
    <div class="section-heading center">
      <span class="eyebrow">Gizlilik</span>
      <h2 id="privacy-title">Hesap yok. Reklam yok. İzleme yok.</h2>
      <p>
        Gebelik profilin, günlük kayıtların, fotoğrafların ve notların telefonunda
        kalır — bizim görebileceğimiz bir sunucuya gitmez. Yalnızca Premium satın
        alman doğrulanırken Apple ve Adapty ile abonelik bilgisi paylaşılır.
      </p>
    </div>

    <ul class="points list-reset">
      {
        points.map((point) => (
          <li>
            <span class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path
                  d={point.path}
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <h3>{point.title}</h3>
            <p>{point.detail}</p>
          </li>
        ))
      }
    </ul>

    <p class="more">
      <a href="/gizlilik-politikasi/">Gizlilik politikasını oku</a>
    </p>
  </div>
</section>

<style>
  .privacy {
    padding-block: var(--section-y);
    background: var(--brand-tint);
    border-block: 1px solid var(--line);
  }

  .points {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .points li {
    padding: var(--space-6);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-xs);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: var(--space-4);
    border-radius: 12px;
    background: var(--brand-tint);
    color: var(--brand-deep);
  }

  .icon svg {
    width: 20px;
    height: 20px;
  }

  .points h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-base);
  }

  .points p {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .more {
    margin-top: var(--space-6);
    text-align: center;
    font-size: var(--text-sm);
  }

  .more a {
    font-weight: 600;
    text-decoration: none;
  }

  .more a:hover {
    text-decoration: underline;
  }

  @media (max-width: 820px) {
    .points {
      grid-template-columns: 1fr;
    }
  }
</style>
