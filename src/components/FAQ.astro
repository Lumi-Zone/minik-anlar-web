---
interface FAQItem {
  q: string;
  a: string;
}

interface Props {
  items: FAQItem[];
  title?: string;
}

const { items, title = 'Sıkça Sorulan Sorular' } = Astro.props;
---

<section class="faq" id="sss" aria-labelledby="faq-title">
  <div class="container">
    <h2 id="faq-title">{title}</h2>

    <div class="faq-list">
      {
        items.map((item) => (
          <details class="faq-item">
            <summary>
              <span>{item.q}</span>
              <span class="icon" aria-hidden="true" />
            </summary>
            <div class="faq-answer">
              <p set:html={item.a} />
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding: 84px 0;
  }

  .faq h2 {
    text-align: center;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin-bottom: 44px;
  }

  .faq-list {
    max-width: var(--prose-width);
    margin-inline: auto;
    display: grid;
    gap: 12px;
  }

  .faq-item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  summary {
    padding: 20px 24px;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* Artı işareti iki sözde elemanla çizilir; açıkken eksiye döner. */
  .icon {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
  }

  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    background: var(--primary);
    border-radius: 2px;
    inset-block: 7px;
    inset-inline: 0;
  }

  .icon::after {
    inset-block: 0;
    inset-inline: 7px;
    transition: opacity 0.2s ease;
  }

  .faq-item[open] .icon::after {
    opacity: 0;
  }

  .faq-answer {
    padding: 0 24px 22px;
    color: var(--text-secondary);
  }

  .faq-answer :global(a) {
    font-weight: 500;
  }
</style>
