---
interface FAQItem {
  q: string;
  a: string;
}

interface Props {
  items: FAQItem[];
  title?: string;
  /** Aynı sayfada iki SSS listesi olursa çapa kimlikleri çakışmasın. */
  id?: string;
}

const { items, title = 'Sıkça Sorulan Sorular', id = 'sss' } = Astro.props;
---

<section class="faq" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="section-heading center">
      <h2 id={`${id}-title`}>{title}</h2>
    </div>

    <div class="list card">
      {
        items.map((item) => (
          <details class="item">
            <summary>
              <span>{item.q}</span>
              <span class="chevron" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none">
                  <path
                    d="M4 6l4 4 4-4"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </summary>
            <div class="answer">
              <p set:html={item.a} />
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--section-y);
  }

  .list {
    max-width: var(--prose-width);
    margin-inline: auto;
    overflow: hidden;
  }

  .item + .item {
    border-top: 1px solid var(--line);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    transition: background-color var(--dur) var(--ease);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    background: var(--surface-sunken);
  }

  summary:focus-visible {
    outline-offset: -3px;
  }

  .chevron {
    display: grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--brand-tint);
    color: var(--brand-deep);
    transition: transform var(--dur) var(--ease);
  }

  .chevron svg {
    width: 15px;
    height: 15px;
  }

  .item[open] .chevron {
    transform: rotate(180deg);
  }

  .answer {
    padding: 0 var(--space-5) var(--space-5);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  /* Destekleyen tarayıcılarda açılma yumuşatılır; diğerlerinde anında açılır. */
  @supports (interpolate-size: allow-keywords) {
    .item::details-content {
      block-size: 0;
      overflow: hidden;
      transition: block-size 240ms var(--ease), content-visibility 240ms allow-discrete;
    }

    .item[open]::details-content {
      block-size: auto;
    }
  }
</style>

<style is:global>
  /* `interpolate-size` kalıtsaldır; kök üzerinde tanımlanmalı. */
  @supports (interpolate-size: allow-keywords) {
    :root {
      interpolate-size: allow-keywords;
    }
  }
</style>
