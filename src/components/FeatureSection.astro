---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro: string;
  items: string[];
  /** Yandaki panelde gösterilen kısa vurgular. */
  highlights: { label: string; value: string }[];
  reverse?: boolean;
}

const { id, eyebrow, title, intro, items, highlights, reverse = false } = Astro.props;
---

<section class={`feature ${reverse ? 'reverse' : ''}`} aria-labelledby={`${id}-title`}>
  <div class="container feature-grid">
    <div class="feature-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${id}-title`}>{title}</h2>
      <p class="intro">{intro}</p>
      <ul class="feature-list">
        {items.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="feature-panel">
      <dl>
        {
          highlights.map((h) => (
            <div class="highlight">
              <dt>{h.label}</dt>
              <dd>{h.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .feature {
    padding: 72px 0;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .feature.reverse .feature-copy {
    order: 2;
  }

  .feature-copy h2 {
    font-size: clamp(1.7rem, 3.6vw, 2.25rem);
    margin-bottom: 14px;
  }

  .intro {
    color: var(--text-secondary);
    font-size: 1.0625rem;
    margin-bottom: 24px;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 13px;
  }

  .feature-list li {
    position: relative;
    padding-left: 30px;
    color: var(--text-secondary);
  }

  .feature-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--primary);
  }

  .feature-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 12px;
    box-shadow: var(--shadow-soft);
  }

  .feature-panel dl {
    margin: 0;
    display: grid;
    gap: 4px;
  }

  .highlight {
    background: var(--page-bg);
    border-radius: var(--radius-sm);
    padding: 18px 20px;
  }

  .highlight dt {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 4px;
  }

  .highlight dd {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .feature {
      padding: 48px 0;
    }

    .feature-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .feature.reverse .feature-copy {
      order: 0;
    }
  }
</style>
