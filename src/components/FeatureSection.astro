---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro: string;
  items: string[];
  /** Yandaki kartta gösterilen kısa vurgular. */
  highlights: { label: string; value: string }[];
  /** Görsel ritim için sırayla metin ve kartın yeri değişir. */
  reverse?: boolean;
}

const { id, eyebrow, title, intro, items, highlights, reverse = false } = Astro.props;
---

<section class={`feature ${reverse ? 'reverse' : ''}`} aria-labelledby={`${id}-title`}>
  <div class="container feature-grid">
    <div class="copy">
      <span class="eyebrow">{eyebrow}</span>
      <h2 id={`${id}-title`}>{title}</h2>
      <p class="intro">{intro}</p>

      <ul class="items list-reset">
        {items.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <dl class="panel card">
      {
        highlights.map((highlight) => (
          <div class="row">
            <dt>{highlight.label}</dt>
            <dd>{highlight.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .feature {
    padding-block: clamp(48px, 6vw, 80px);
  }

  /* Ardışık özellikler ince bir çizgiyle ayrılır. */
  .feature + .feature {
    border-top: 1px solid var(--line);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: start;
    gap: clamp(32px, 5vw, 72px);
  }

  .feature.reverse .copy {
    order: 2;
  }

  /* Ters sırada metin ikinci sütuna geçtiği için sütun genişlikleri de
     takas edilir; metin her satırda aynı genişlikte kalır. */
  .feature.reverse .feature-grid {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  h2 {
    font-size: var(--display-sm);
  }

  .intro {
    margin-top: var(--space-3);
    color: var(--ink-2);
  }

  .items {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .items li {
    position: relative;
    padding-left: 26px;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .items li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.6em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand);
  }

  .panel {
    padding-inline: var(--space-6);
  }

  .row {
    padding-block: var(--space-5);
  }

  .row + .row {
    border-top: 1px solid var(--line);
  }

  dt {
    color: var(--ink-3);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd {
    margin-top: var(--space-1);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .feature-grid,
    .feature.reverse .feature-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .feature.reverse .copy {
      order: 0;
    }
  }
</style>
